<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- App Icon + Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="32dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💰"
                android:textSize="52sp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Finance Tracker"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SMS Auto-Import"
                android:textSize="13sp"
                android:textColor="#888888"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Status Card -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚪ Inactive — Enter webhook URL and activate"
            android:textSize="13sp"
            android:textColor="#888888"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:paddingHorizontal="16dp"
            android:background="@drawable/card_background"
            android:layout_marginBottom="24dp"/>

        <!-- Webhook URL label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WEBHOOK URL"
            android:textSize="11sp"
            android:textColor="#888888"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp"/>

        <!-- Webhook URL input -->
        <EditText
            android:id="@+id/webhookUrlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://your-backend.com/api/sms/webhook/..."
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:background="@drawable/input_background"
            android:padding="14dp"
            android:inputType="textUri"
            android:singleLine="true"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Copy this from Finance Tracker → Settings → SMS Auto-Import"
            android:textSize="11sp"
            android:textColor="#666666"
            android:layout_marginBottom="24dp"/>

        <!-- Activate Button -->
        <Button
            android:id="@+id/activateBtn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="⚡ Activate SMS Tracking"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_primary"
            android:layout_marginBottom="12dp"/>

        <!-- Test Button -->
        <Button
            android:id="@+id/testBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="🧪 Send Test Transaction"
            android:textSize="14sp"
            android:textColor="#AAAAAA"
            android:background="@drawable/btn_secondary"
            android:layout_marginBottom="32dp"/>

        <!-- How it works section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HOW IT WORKS"
            android:textSize="11sp"
            android:textColor="#888888"
            android:letterSpacing="0.1"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="1. 📲  You pay via GPay / PhonePe / UPI"
                android:textColor="#CCCCCC" android:textSize="13sp" android:paddingBottom="8dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="2. 📩  Bank sends you a transaction SMS"
                android:textColor="#CCCCCC" android:textSize="13sp" android:paddingBottom="8dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="3. 🤖  This app detects it automatically"
                android:textColor="#CCCCCC" android:textSize="13sp" android:paddingBottom="8dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="4. ✅  Transaction added to your dashboard!"
                android:textColor="#22C55E" android:textSize="13sp" android:textStyle="bold"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="This app runs silently with no UI. You can close it after activation — it continues working in the background."
            android:textSize="12sp"
            android:textColor="#555555"
            android:gravity="center"
            android:paddingBottom="24dp"/>

    </LinearLayout>
</ScrollView>
